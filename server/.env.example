MONGO_URI=your_mongodb_atlas_connection_string
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.2
OPENAI_ENABLE_WEB_SEARCH=true
# Uses OpenAI web search to diversify exact-role sources beyond direct APIs.
# Every result still passes JumpTake's independent HTTP role/apply verifier.
OPENAI_JOB_WEB_DISCOVERY=true
# Avoids repeatedly retrying every model when the OpenAI account has no quota.
OPENAI_PROVIDER_BACKOFF_MS=30000
# Optional: enables direct JSearch/RapidAPI candidate retrieval before every
# candidate is independently checked against its exact role and Apply pages.
RAPIDAPI_KEY=your_rapidapi_key
# Optional comma-separated Greenhouse board tokens. Each entry may use
# token|Display Name. When omitted, JumpTake uses its built-in public-board list.
# Example: anthropic|Anthropic,stripe|Stripe,figma|Figma
GREENHOUSE_JOB_BOARD_TOKENS=
# Optional timeout for each role/apply page verification request.
JOB_LINK_TIMEOUT_MS=12000
JWT_SECRET=your_secure_jwt_secret
NODE_ENV=production
CLIENT_URL=https://your-jumptake-domain.example

# Stripe subscriptions. Create recurring GBP prices for Premium (£5/month)
# and Extreme (£12/month), then copy their price IDs here.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
STRIPE_DEMO_PREMIUM_PRICE_ID=price_your_demo_premium_price
STRIPE_PREMIUM_PRICE_ID=price_your_premium_price
STRIPE_EXTREME_PRICE_ID=price_your_extreme_price
